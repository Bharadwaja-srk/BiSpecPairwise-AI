# Copy to .env (never commit real secrets)
MODEL_PATH=models/xgb_pairwise_v1.pkl
DATA_PATH=data
ML_PORT=8001
RANDOM_SEED=42

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bspai
ML_SERVICE_URL=http://ml:8001
ML_SERVICE_TIMEOUT=30
RAG_SERVICE_URL=http://rag:8002
RAG_SERVICE_TIMEOUT=60
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production
FEATURE_STORE_PATH=data/precomputed_features.json
ENABLE_MOCK_ML=false
ENABLE_MOCK_RAG=true
ENABLE_MOCK_LLM=true

# RAG / LLM
RAG_PORT=8002
LLM_PROVIDER=mock
LLM_MODEL=mock-llm
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=128
# Production biomedical retrieval (requires sentence-transformers + torch in
# the RAG container; see rag/embeddings/model_manifest.json for provenance):
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
# EMBEDDING_REVISION=b79526d6ef3645e0df4530322e266f24c829f5ef
# EMBEDDING_DIM=768
VECTOR_STORE_PATH=
